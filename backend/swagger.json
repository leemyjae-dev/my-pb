{
  "openapi": "3.0.3",
  "info": {
    "title": "my-pb API",
    "version": "1.0.0",
    "description": "개인 투자성향·심리민감도 기반 자산배분 진단 앱 (my-pb)의 REST API 명세. `docs/2-PRD.md`(v1.1)의 FR-0~FR-4 요구사항과 `docs/1-domain-definition.md`(v1.2)의 도메인 규칙, `docs/8-plan.md`의 백엔드 Task에 명시된 엔드포인트를 근거로 작성했다. 2일·1인 개발 MVP 범위이며, 문서에 근거 없는 엔드포인트/파라미터는 추가하지 않았다."
  },
  "servers": [
    {
      "url": "http://localhost:{PORT}",
      "description": "로컬 개발 서버 (배포 환경은 PRD 9절 기준 미정 — 확인 필요)",
      "variables": {
        "PORT": {
          "default": "3000",
          "description": "backend/.env의 PORT 값 (기본값은 임의 예시이며 실제 값은 .env 설정을 따름)"
        }
      }
    }
  ],
  "tags": [
    { "name": "auth", "description": "회원가입/로그인/토큰 재발급 (FR-0)" },
    { "name": "kyc", "description": "투자자성향(KYC) 설문 (FR-1)" },
    { "name": "neuroticism", "description": "IPIP 신경성 검사 (FR-2)" },
    { "name": "holdings", "description": "잔고 스크린샷 업로드 및 자산 항목 보정 (FR-3)" },
    { "name": "diagnosis", "description": "종합 진단 결과 (FR-4)" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "description": "공통 에러 응답 형식. 정확한 포맷(필드명 등)은 backend error.middleware.js 구현에 따르며, 이 명세에서는 최소 형태만 가정했다 (확인 필요).",
        "properties": {
          "message": { "type": "string", "example": "잘못된 요청입니다." }
        },
        "required": ["message"]
      },
      "User": {
        "type": "object",
        "description": "사용자(User). 비밀번호 해시는 응답에 노출하지 않는다.",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "email": { "type": "string", "format": "email" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "email", "createdAt"]
      },
      "SignupRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password", "minLength": 1 }
        },
        "required": ["email", "password"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        },
        "required": ["email", "password"]
      },
      "AuthTokens": {
        "type": "object",
        "description": "로그인 성공 시 발급되는 토큰 쌍 (PRD FR-0.4). 유효기간·refresh_token 저장 방식은 PRD 9절 확인 필요 사항.",
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" }
        },
        "required": ["accessToken", "refreshToken"]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": { "type": "string" }
        },
        "required": ["refreshToken"]
      },
      "RefreshResponse": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" }
        },
        "required": ["accessToken"]
      },
      "KycSubmitRequest": {
        "type": "object",
        "description": "투자자성향(KYC) 설문 응답 제출. 문항 수·배점·실제 문항 내용은 도메인 정의서 8절 기준 미확정이며, 여기서는 확정된 규칙(10문항, 각 1~5점)만 반영했다.",
        "properties": {
          "answers": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 5 },
            "minItems": 10,
            "maxItems": 10,
            "description": "문항 순서대로의 응답값 10개 (각 1~5점)"
          }
        },
        "required": ["answers"]
      },
      "KycProfileResult": {
        "type": "object",
        "description": "투자자성향 진단결과(KycProfileResult). 등급 구간은 도메인 정의서 6절 기준.",
        "properties": {
          "id": { "type": "integer" },
          "answers": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 5 },
            "minItems": 10,
            "maxItems": 10
          },
          "totalScore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "100점 환산 총점"
          },
          "riskGrade": {
            "type": "string",
            "enum": ["안정형", "안정추구형", "위험중립형", "적극투자형", "공격투자형"],
            "description": "0~19 안정형, 20~39 안정추구형, 40~59 위험중립형, 60~79 적극투자형, 80~100 공격투자형 (도메인 정의서 6절). 실제 저장 값이 한글 문자열인지 영문 코드인지는 schema.sql 기준 미확정 — 확인 필요."
          },
          "takenAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "answers", "totalScore", "riskGrade", "takenAt"]
      },
      "NeuroticismSubmitRequest": {
        "type": "object",
        "description": "IPIP 신경성 검사 응답 제출. 역채점 문항 반전(6-응답값) 처리는 서버에서 수행하므로 클라이언트는 원 응답값만 전송한다. 문항의 한국어 번역본 출처는 도메인 정의서 8절 기준 미확정.",
        "properties": {
          "answers": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 5 },
            "minItems": 10,
            "maxItems": 10,
            "description": "문항 순서대로의 응답값 10개 (각 1~5점, 전혀 그렇지 않다~매우 그렇다)"
          }
        },
        "required": ["answers"]
      },
      "NeuroticismTestResult": {
        "type": "object",
        "description": "IPIP 신경성 검사결과(NeuroticismTestResult).",
        "properties": {
          "id": { "type": "integer" },
          "answers": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 5 },
            "minItems": 10,
            "maxItems": 10
          },
          "totalScore": {
            "type": "integer",
            "minimum": 10,
            "maximum": 50,
            "description": "역채점 반전 후 합산한 신경성 총점 (10문항 x 1~5점)"
          },
          "sensitivityGrade": {
            "type": "string",
            "enum": ["보통", "높음"],
            "description": "신경성 총점이 평균 대비 1표준편차 이상이면 '높음' (도메인 정의서 6절). 판정 기준값(평균/표준편차)의 출처는 도메인 정의서 8절 기준 미확정."
          },
          "takenAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "answers", "totalScore", "sensitivityGrade", "takenAt"]
      },
      "AssetClass": {
        "type": "object",
        "description": "자산군(AssetClass) 마스터 데이터. 실제 자산군 목록은 DB-3 초기 데이터 입력에 따름 (도메인 정의서 8절 성향기준 비중표와 함께 미확정).",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "example": "주식" }
        },
        "required": ["id", "name"]
      },
      "HoldingItem": {
        "type": "object",
        "description": "자산 항목(HoldingItem).",
        "properties": {
          "id": { "type": "integer" },
          "rawName": { "type": "string", "description": "인식된 종목명 원본 텍스트" },
          "quantity": {
            "type": "number",
            "nullable": true,
            "description": "수량 (펀드 등 수량이 없는 항목은 null, 와이어프레임 2.7절 참조)"
          },
          "amount": { "type": "number", "description": "평가금액" },
          "assetClass": { "$ref": "#/components/schemas/AssetClass" },
          "classificationStatus": {
            "type": "string",
            "enum": ["자동분류확정", "보정필요", "보정완료"],
            "description": "도메인 정의서 3절의 분류 확정 여부(자동 분류 확정/사용자 보정 필요/사용자 보정 완료)에 대응. 실제 저장 값 인코딩은 schema.sql 기준 미확정 — 확인 필요."
          }
        },
        "required": ["id", "rawName", "amount", "assetClass", "classificationStatus"]
      },
      "AssetClassWeight": {
        "type": "object",
        "description": "자산군별 집계 비중.",
        "properties": {
          "assetClassName": { "type": "string" },
          "weightPercent": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "required": ["assetClassName", "weightPercent"]
      },
      "HoldingsSnapshot": {
        "type": "object",
        "description": "보유잔고 스냅샷(HoldingsSnapshot).",
        "properties": {
          "id": { "type": "integer" },
          "imageUrl": { "type": "string", "description": "원본 스크린샷 이미지 참조 경로. 저장 위치/보관 정책은 도메인 정의서 8절 기준 미확정." },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/HoldingItem" }
          },
          "assetClassWeights": {
            "type": "array",
            "nullable": true,
            "items": { "$ref": "#/components/schemas/AssetClassWeight" },
            "description": "자산군별 집계 비중. 보정 확정 전에는 null."
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "보정 완료(확정) 일시. 확정 전에는 null."
          },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "imageUrl", "items", "createdAt"]
      },
      "HoldingItemUpdateRequest": {
        "type": "object",
        "description": "자산 항목의 자산군을 사용자가 직접 보정할 때 사용한다 (FR-3.4).",
        "properties": {
          "assetClassId": { "type": "integer" }
        },
        "required": ["assetClassId"]
      },
      "AssetClassComparison": {
        "type": "object",
        "description": "자산군별 성향기준 비중 대비 실보유 비중 비교 결과.",
        "properties": {
          "assetClassName": { "type": "string" },
          "targetWeightPercent": { "type": "number", "description": "투자자성향 등급의 성향기준 비중. 실제 수치는 도메인 정의서 8절 성향기준 비중표 기준 미확정." },
          "actualWeightPercent": { "type": "number", "description": "실보유 자산배분 비중" },
          "judgment": {
            "type": "string",
            "enum": ["정합", "괴리(초과)", "괴리(과소)"],
            "description": "정합/괴리 판정. 몇 %p 이상 차이일 때 '괴리'로 볼지의 허용 오차(임계값)는 도메인 정의서 8절 기준 미확정."
          }
        },
        "required": ["assetClassName", "targetWeightPercent", "actualWeightPercent", "judgment"]
      },
      "RiskDiagnosisResult": {
        "type": "object",
        "description": "리스크 진단 결과(RiskDiagnosisResult). 투자자성향 진단결과·IPIP 신경성 검사결과·보유잔고 스냅샷 각 최신 1건을 결합해 생성된다 (FR-4.1).",
        "properties": {
          "id": { "type": "integer" },
          "kycProfileResultId": { "type": "integer" },
          "neuroticismTestResultId": { "type": "integer" },
          "holdingsSnapshotId": { "type": "integer" },
          "riskGrade": {
            "type": "string",
            "enum": ["안정형", "안정추구형", "위험중립형", "적극투자형", "공격투자형"],
            "description": "참조한 투자자성향 진단결과의 등급"
          },
          "sensitivityGrade": {
            "type": "string",
            "enum": ["보통", "높음"],
            "description": "참조한 IPIP 신경성 검사결과의 심리민감도 등급"
          },
          "comparisonResult": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AssetClassComparison" }
          },
          "psychologicalBurdenFlag": {
            "type": "boolean",
            "description": "심리민감도 '높음'이고 동시에 괴리가 있는 경우 true (FR-4.3)"
          },
          "feedbackMessage": {
            "type": "string",
            "description": "정합 시 긍정 피드백, 괴리 시 조정 방향 피드백 메시지 (FR-4.4)"
          },
          "diagnosedAt": { "type": "string", "format": "date-time" }
        },
        "required": [
          "id",
          "kycProfileResultId",
          "neuroticismTestResultId",
          "holdingsSnapshotId",
          "riskGrade",
          "sensitivityGrade",
          "comparisonResult",
          "psychologicalBurdenFlag",
          "feedbackMessage",
          "diagnosedAt"
        ]
      },
      "DiagnosisIncompleteResponse": {
        "type": "object",
        "description": "KYC/신경성검사/잔고 스냅샷 중 하나 이상이 없어 종합 진단을 수행할 수 없는 경우의 응답 (FR-4.6).",
        "properties": {
          "complete": { "type": "boolean", "enum": [false] },
          "missingInputs": {
            "type": "array",
            "items": { "type": "string", "enum": ["kyc", "neuroticism", "holdings"] }
          }
        },
        "required": ["complete", "missingInputs"]
      }
    }
  },
  "paths": {
    "/api/auth/signup": {
      "post": {
        "tags": ["auth"],
        "summary": "회원가입",
        "description": "이메일/비밀번호로 회원가입한다 (FR-0.1). 비밀번호는 bcrypt로 해시하여 저장한다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SignupRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "회원가입 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "409": {
            "description": "이미 가입된 이메일",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "로그인",
        "description": "이메일/비밀번호로 로그인하고 access_token/refresh_token을 발급한다 (FR-0.2, FR-0.4).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthTokens" } } }
          },
          "401": {
            "description": "이메일 또는 비밀번호 불일치",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["auth"],
        "summary": "액세스 토큰 재발급",
        "description": "refresh_token으로 새로운 access_token을 발급한다 (FR-0.4).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "재발급 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshResponse" } } }
          },
          "401": {
            "description": "refresh_token이 유효하지 않거나 만료됨 (재로그인 필요)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/kyc": {
      "post": {
        "tags": ["kyc"],
        "summary": "투자자성향(KYC) 설문 응시",
        "description": "10문항 응답을 제출해 총점·등급을 산출하고 저장한다 (FR-1.1~FR-1.3). 재응시 시 새 결과가 별도로 생성된다 (FR-1.4).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/KycSubmitRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "설문 제출 및 채점 완료",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/KycProfileResult" } } }
          },
          "400": {
            "description": "응답 개수/범위가 유효하지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/kyc/latest": {
      "get": {
        "tags": ["kyc"],
        "summary": "가장 최근 투자자성향 진단결과 조회",
        "description": "로그인 사용자의 가장 최근 KYC 진단결과를 조회한다. 대시보드 화면(와이어프레임 2.3)의 KYC 상태 카드에 사용된다.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/KycProfileResult" } } }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "아직 응시한 결과가 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/neuroticism": {
      "post": {
        "tags": ["neuroticism"],
        "summary": "IPIP 신경성 검사 응시",
        "description": "10문항 응답을 제출해 역채점 반전 후 총점·심리민감도 등급을 산출하고 저장한다 (FR-2.1~FR-2.4). 재응시 시 새 결과가 별도로 생성된다 (FR-2.5).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/NeuroticismSubmitRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "검사 제출 및 채점 완료",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NeuroticismTestResult" } } }
          },
          "400": {
            "description": "응답 개수/범위가 유효하지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/neuroticism/latest": {
      "get": {
        "tags": ["neuroticism"],
        "summary": "가장 최근 IPIP 신경성 검사결과 조회",
        "description": "로그인 사용자의 가장 최근 신경성 검사결과를 조회한다. 대시보드 화면(와이어프레임 2.3)의 IPIP 상태 카드에 사용된다.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NeuroticismTestResult" } } }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "아직 응시한 결과가 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/holdings": {
      "post": {
        "tags": ["holdings"],
        "summary": "잔고 스크린샷 업로드",
        "description": "증권 계좌 잔고 스크린샷 이미지를 업로드하면 종목명·수량·평가금액을 인식(OCR/AI 비전)하고 자산군을 자동 분류해 보유잔고 스냅샷과 자산 항목을 생성한다 (FR-3.1~FR-3.3). 업로드 파일 크기/형식 제한값은 PRD 9절 기준 미확정. 재업로드 시 새 스냅샷이 별도로 생성된다 (FR-3.6).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "증권 계좌 잔고 화면 스크린샷 이미지"
                  }
                },
                "required": ["image"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "업로드 및 인식 완료 (분류 확정 전 상태, assetClassWeights/confirmedAt은 null)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HoldingsSnapshot" } } }
          },
          "400": {
            "description": "허용되지 않은 파일 형식이거나 크기 초과",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/holdings/latest": {
      "get": {
        "tags": ["holdings"],
        "summary": "가장 최근 보유잔고 스냅샷 조회",
        "description": "로그인 사용자의 가장 최근 보유잔고 스냅샷을 조회한다. `docs/8-plan.md`에는 명시되어 있지 않으나, 대시보드 화면(와이어프레임 2.3)의 잔고 스크린샷 상태 카드(완료 여부/업로드 일시 표시)를 위해 KYC/IPIP의 `/latest` 엔드포인트와 동일한 패턴으로 추가했다.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HoldingsSnapshot" } } }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "아직 업로드한 스냅샷이 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/holdings/{snapshotId}/items/{itemId}": {
      "patch": {
        "tags": ["holdings"],
        "summary": "자산 항목 자산군 보정",
        "description": "자동 분류가 애매한 자산 항목의 자산군을 사용자가 직접 수정한다 (FR-3.4).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "snapshotId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "itemId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/HoldingItemUpdateRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "보정 완료",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HoldingItem" } } }
          },
          "400": {
            "description": "유효하지 않은 assetClassId",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "스냅샷 또는 자산 항목을 찾을 수 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/holdings/{snapshotId}/confirm": {
      "post": {
        "tags": ["holdings"],
        "summary": "자산 항목 보정 확정",
        "description": "모든 자산 항목이 확정 상태일 때 자산군별 비중을 계산해 보유잔고 스냅샷을 확정한다 (FR-3.5). 보정 필요 항목이 남아있으면 확정이 거부된다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "snapshotId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "확정 완료 (assetClassWeights/confirmedAt 채워짐)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HoldingsSnapshot" } } }
          },
          "400": {
            "description": "보정 필요 상태인 자산 항목이 남아있어 확정할 수 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "스냅샷을 찾을 수 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/diagnosis": {
      "post": {
        "tags": ["diagnosis"],
        "summary": "종합 진단 결과 생성/조회",
        "description": "가장 최근의 투자자성향 진단결과, IPIP 신경성 검사결과, 보유잔고 스냅샷 각 1건을 결합해 종합 진단을 수행한다 (FR-4.1~FR-4.5). 3종 입력 중 하나라도 없으면 부족한 항목을 안내하는 응답을 반환한다 (FR-4.6).",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "3종 입력 중 하나 이상이 부족해 진단을 생성하지 못함",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DiagnosisIncompleteResponse" } } }
          },
          "201": {
            "description": "3종 입력을 모두 결합한 종합 진단 결과 생성 완료",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RiskDiagnosisResult" } } }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    }
  }
}
